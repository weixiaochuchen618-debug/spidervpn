%% 部署中心类图（A2/A3）。
%% 权威版本：deliverables/software-company/tcrs-a2a3-deployment-center-arch-20261108.md §3.6。
%% 字段与契约文档 docs/ipc-contract-0.1.4.md §4.16.2 / §4.16.4 一一对应，改动三处必须同步。
classDiagram
  direction LR

  class RunRecord {
    +u32 schemaVersion
    +String kind
    +String runId
    +u32 attemptNo
    +String label
    +Target target
    +Identity identity
    +Plan plan
    +String planDigest
    +String state
    +u8 step
    +Reason reason
    +String nextAction
    +List~StepRecord~ steps
    +PendingOperation pending
    +List~AttemptRecord~ attempts
    +Executor executor
    +String createdAtUtc
    +String startedAtUtc
    +String updatedAtUtc
    +String finishedAtUtc
    +u64 revision
    +to_json() Value
    +from_json(Value) RunRecord
    +steps_done() u32
  }

  class Target {
    +String host
    +u16 port
    +String user
    +String serverRecordId
    +lane_key() String
  }

  class Identity {
    +String fingerprint
    +bool autoTrusted
  }

  class Plan {
    +String interface
    +u16 udpPort
    +String subnet
    +u16 mtu
    +String clientPublicKey
  }

  class StepRecord {
    +u8 index
    +String name
    +String status
    +String startedAtUtc
    +String finishedAtUtc
    +Value evidence
    +Reason error
  }

  class PendingOperation {
    +String kind
    +u32 attemptNo
    +String startedAtUtc
    +String verifyBy
    +String planDigest
    +String clientPublicKey
    +String outcome
  }

  class Reason {
    +String category
    +String class
    +String code
    +String text
    +String at
  }

  class AttemptRecord {
    +u32 no
    +String startedAtUtc
    +String finishedAtUtc
    +u8 failedStep
    +String errorCode
    +String reconcile
  }

  class Executor {
    +String instanceId
    +i64 pid
    +String heartbeatAtUtc
    +bool background
  }

  class DeploymentStore {
    +Path root
    +create(RunRecord) Result
    +save(RunRecord) Result
    +load(runId) Result~RunRecord~
    +load_all() LoadResult
    +prune_terminal(keep u32) Result
    +write_atomic(Path, Value) Result
    +classify_read_error(io::Error) String
  }

  class LoadResult {
    +List~RunRecord~ runs
    +List~Unreadable~ unreadable
    +String tasksRead
    +String error
  }

  class DeploymentStateMachine {
    +transition_ok(from String, to String) bool
    +plan_pass(RunRecord) PassPlan
    +settle_step(RunRecord, StepOutcome) RunRecord
    +recover(RunRecord, i64 currentPid, i64 nowSecs, bool active) RunRecord
    +can_background(RunRecord, bool active) bool
    +humanize(Reason) String
  }

  class Projection {
    +project_tasks(List~RunRecord~, ActiveSet) List~Value~
    +project_deployments(List~RunRecord~, ActiveSet) List~Value~
    +project_run(RunRecord, ActiveSet) Value
    +sort_tasks(List~Value~) List~Value~
  }

  class DeploymentEngine {
    +EngineHandle handle
    -Sender~Cmd~ tx
    -EngineShared shared
    -DeploymentStore store
    -Ops ops
    +start(RunId, Secret) Accepted
    +continue_run(RunId, Secret, bool) Accepted
    +pause(RunId) Accepted
    +cancel(RunId) Accepted
    +background(RunId) Accepted
    +is_active(RunId) bool
    +snapshot_shared() SharedView
    -supervisor_loop()
    -run_pass(RunId)
  }

  class EngineShared {
    +String instanceId
    +Map active
    +List queued
    +u64 revision
    +String storeError
    +active_count() usize
    +lane_busy(String) bool
  }

  class ActivePass {
    +String runId
    +String stage
    +String laneKey
    +u64 startedAtSecs
    +bool pauseRequested
    +bool cancelRequested
    +bool secretPresent
  }

  class Ops {
    <<interface>>
    +resolve_identity(OpsReq) Result
    +check_environment(OpsReq) Result
    +install_udp(OpsReq) Result
    +probe_udp_state(OpsReq) Result
    +install_transport(OpsReq) Result
    +read_transport(OpsReq) Result
    +add_peer(OpsReq) Result
    +register_lines(OpsReq) Result
  }

  class ProdOps {
    +resolve_identity(OpsReq) Result
    +check_environment(OpsReq) Result
    +install_udp(OpsReq) Result
    +probe_udp_state(OpsReq) Result
    +install_transport(OpsReq) Result
    +read_transport(OpsReq) Result
    +add_peer(OpsReq) Result
    +register_lines(OpsReq) Result
  }

  class IpcDeployment {
    +handle(cmd String, Ctx) String
    -start(Ctx, Value) String
    -list(Ctx) String
    -get(Ctx, Value) String
    -continue_cmd(Ctx, Value) String
    -pause(Ctx, Value) String
    -cancel(Ctx, Value) String
    -background(Ctx, Value) String
  }

  class WebUi {
    +Option~FormState~ form
    +DeployShared shared
    +Option~DeployCache~ deploy_cache
    +snapshot(fetch) Value
    +route(msg, fetch) List~Step~
    +absorb_reply(cmd, Value)
  }

  class DeployFormState {
    +String run_id
    +u8 wizard_step
    +String spec
    +String fingerprint
    +bool known
    +Value run_view
    +apply_run_view(Value)
    +render_deploy() Value
  }

  class UiExitGuard {
    +Option~String~ deploying()
    +OnCloseDecision close_decision(bool trayAvailable)
    +bool allow_tray_quit()
  }

  RunRecord "1" *-- "1" Target
  RunRecord "1" *-- "1" Identity
  RunRecord "1" *-- "1" Plan
  RunRecord "1" *-- "4" StepRecord
  RunRecord "1" o-- "0..1" PendingOperation
  RunRecord "1" o-- "0..1" Reason
  RunRecord "1" *-- "1..*" AttemptRecord
  RunRecord "1" o-- "0..1" Executor
  StepRecord "0..1" o-- "0..1" Reason

  DeploymentStore ..> RunRecord : 读/写
  DeploymentStore ..> LoadResult : 产出
  DeploymentStateMachine ..> RunRecord : 纯变换
  Projection ..> RunRecord : 只读投影
  DeploymentEngine "1" *-- "1" EngineShared
  DeploymentEngine "1" *-- "1" DeploymentStore
  DeploymentEngine "1" o-- "1..3" ActivePass
  DeploymentEngine ..> Ops : 通过接口调用
  ProdOps ..|> Ops
  IpcDeployment ..> DeploymentEngine : 投递意图
  IpcDeployment ..> DeploymentStore : 创建/读取
  WebUi ..> DeploymentEngine : 读 shared（只读）
  WebUi ..> Projection : 投影
  WebUi "1" o-- "0..1" DeployFormState
  UiExitGuard ..> DeploymentEngine : 询问是否在跑
